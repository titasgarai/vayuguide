{
  "name": "vayuguide",
  "version": "1.0.0",
  "private": true,
  "description": "VayuGuide — Real-time pan-India Urban Air Quality Assistant powered by WAQI/Open-Meteo telemetry and Gemini 2.5 Flash.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
