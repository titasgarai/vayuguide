# Required: Google Gemini API key (https://aistudio.google.com/apikey)
# Keep server-side only — NEVER prefix with NEXT_PUBLIC_
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: WAQI / CPCB live station token (https://aqicn.org/data-platform/token/)
# Falls back automatically to Open-Meteo's live pan-India API if omitted.
WAQI_API_TOKEN=

